# Radiona ULX3S v2.0 (LFE5U, CABGA381): escapement_board's pins on the GPIO headers.
# Sites from emard/ulx3s doc/constraints/ulx3s_v20.lpf. All 3.3 V.
# J1: clk and rst_n on gp/gn[0] (PCLK), ui_in on gn[1..8], uo_out on gp[1..8].
# J2: bank A (uio) on gp/gn[22..25]. Unused: gp/gn[11..13] (ESP32), [14..17] (ADC).

LOCATE COMP "clk"   SITE "B11";   # gp[0], PCLK
LOCATE COMP "rst_n" SITE "C11";   # gn[0]
FREQUENCY PORT "clk" 25 MHZ;

LOCATE COMP "ui_in[0]" SITE "A11";   # gn[1] CS_n
LOCATE COMP "ui_in[1]" SITE "B10";   # gn[2] SCK
LOCATE COMP "ui_in[2]" SITE "C10";   # gn[3] MOSI
LOCATE COMP "ui_in[3]" SITE "A8";    # gn[4] bank B in
LOCATE COMP "ui_in[4]" SITE "B8";    # gn[5]
LOCATE COMP "ui_in[5]" SITE "C7";    # gn[6]
LOCATE COMP "ui_in[6]" SITE "B6";    # gn[7]
LOCATE COMP "ui_in[7]" SITE "A5";    # gn[8]

LOCATE COMP "uo_out[0]" SITE "A10";  # gp[1] MISO
LOCATE COMP "uo_out[1]" SITE "A9";   # gp[2] IRQ
LOCATE COMP "uo_out[2]" SITE "B9";   # gp[3] RUN
LOCATE COMP "uo_out[3]" SITE "A7";   # gp[4] bank B out
LOCATE COMP "uo_out[4]" SITE "C8";   # gp[5]
LOCATE COMP "uo_out[5]" SITE "C6";   # gp[6]
LOCATE COMP "uo_out[6]" SITE "A6";   # gp[7]
LOCATE COMP "uo_out[7]" SITE "A4";   # gp[8]

LOCATE COMP "uio[0]" SITE "B15";     # gp[22] bank A
LOCATE COMP "uio[1]" SITE "B17";     # gp[23]
LOCATE COMP "uio[2]" SITE "C16";     # gp[24]
LOCATE COMP "uio[3]" SITE "D14";     # gp[25]
LOCATE COMP "uio[4]" SITE "C15";     # gn[22]
LOCATE COMP "uio[5]" SITE "C17";     # gn[23]
LOCATE COMP "uio[6]" SITE "D16";     # gn[24]
LOCATE COMP "uio[7]" SITE "E14";     # gn[25]

IOBUF PORT "clk"   PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "rst_n" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[0]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[1]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[2]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[3]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[4]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[5]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[6]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "ui_in[7]" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "uo_out[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uo_out[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "uio[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
