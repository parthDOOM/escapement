    (op == ENC_OP_LINE) |
    (op == ENC_OP_GETL) |
    (op == ENC_OP_MON) |
    (op == ENC_OP_GETM);
endfunction

// the payload bits an opcode's format names (0 for an unlisted opcode); every other
// payload bit is reserved
function [23:0] enc_used;
  input [7:0] op;
  enc_used =
    ({24{(op == ENC_OP_NOP)}} & ENC_FMT_N_USED) |
    ({24{(op == ENC_OP_HALT)}} & ENC_FMT_N_USED) |
