// 1 for a wait-class opcode (isa.yaml wait_class)
function enc_wait_class;
  input [7:0] op;
  enc_wait_class =
    (op == ENC_OP_HALT) |
    (op == ENC_OP_WAITT) |
    (op == ENC_OP_EMIT) |
    (op == ENC_OP_EMITR) |
    (op == ENC_OP_EMITX) |
    (op == ENC_OP_EXPECT) |
    (op == ENC_OP_SAMPLE) |
    (op == ENC_OP_SEND) |
    (op == ENC_OP_WAITP) |
    (op == ENC_OP_GETI) |
    (op == ENC_OP_POP) |
    (op == ENC_OP_PUSH) |
    (op == ENC_OP_LINE) |
    (op == ENC_OP_GETL);
endfunction

