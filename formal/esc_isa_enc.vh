// formats: each named field's [msb, lsb]; every other payload bit is reserved
//   N    no operands
//   I8   code [7:0]
//   R    rd [23:22], rs [21:20]
//   RD   rd [23:22]
//   RS   rs [21:20]
//   I16  rd [23:22], imm [15:0]
//   SH   rd [23:22], n [4:0]
//   B    target [8:0]
//   L16  imm [15:0]
//   T24  imm [23:0]
//   P    mask [23:16], value [15:8], oe [7:0]
//   PR   mask [23:16], rs [15:14], oe [7:0]
//   PX   mask [23:16], dir [15:15], oe [7:0]
//   PE   mask [23:16], level [15:8], mode [7:7], window [6:0]
//   PS   pin [18:16], dir [15:15]
//   PW   mask [23:16], value [15:8]
//   TM   ra [23:22], rb [21:20], imm [7:0]
localparam [23:0] ENC_FMT_N_USED = 24'h000000;
localparam [23:0] ENC_FMT_I8_USED = 24'h0000FF;
localparam [23:0] ENC_FMT_R_USED = 24'hF00000;
