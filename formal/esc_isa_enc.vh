localparam [23:0] ENC_FMT_PW_USED = 24'hFFFF00;
localparam [23:0] ENC_FMT_TM_USED = 24'hF000FF;

// 1 if the opcode is listed in isa.yaml (an unlisted one is ILLEGAL)
function enc_listed;
  input [7:0] op;
  enc_listed =
    (op == ENC_OP_NOP) |
    (op == ENC_OP_HALT) |
    (op == ENC_OP_IRQ) |
    (op == ENC_OP_RET) |
