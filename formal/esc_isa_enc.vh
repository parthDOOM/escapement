    (op == ENC_OP_SAMPLE) |
    (op == ENC_OP_SEND) |
    (op == ENC_OP_GETP) |
    (op == ENC_OP_WAITP) |
    (op == ENC_OP_GETI) |
    (op == ENC_OP_GETX) |
    (op == ENC_OP_LDT) |
    (op == ENC_OP_STT) |
    (op == ENC_OP_CAPT) |
    (op == ENC_OP_GETC) |
    (op == ENC_OP_POP) |
    (op == ENC_OP_PUSH) |
