# D-29: the clock-gated register bank is exactly an enable flip-flop, and its gated
# clock is glitch-free (formal/esc_greg_env.v G1-G3). Run: sby -f esc_greg.sby
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12
multiclock on

[engines]
smtbmc

[script]
read -formal -DFORMAL -DESC_CG_FORMAL esc_greg.v esc_greg_env.v
prep -top esc_greg_env

[files]
../src/esc_greg.v
esc_greg_env.v
